{"id": "hard-floor-1", "example": "floor-push", "style": "hard", "source": "hand-written", "question": "A delivery worker shoves a 24 kg parcel across a warehouse floor with a steady horizontal 90 N. The floor's static and kinetic friction coefficients are 0.25 and 0.2. Three seconds after the shove begins, how quickly is the parcel speeding up, and what is the normal force on it?", "scene": {"version": 1.1, "bodies": [{"id": "parcel", "mass": "24 kg"}], "surfaces": [{"id": "floor", "kind": "plane", "friction": {"static": 0.25, "kinetic": 0.2}}], "contacts": [{"body": "parcel", "surface": "floor"}], "forces": [{"id": "shove", "kind": "applied", "body": "parcel", "magnitude": "90 N", "directionAngle": "0 deg", "relativeTo": "floor"}], "queries": [{"id": "a", "ask": "acceleration", "body": "parcel", "at": 3}, {"id": "N", "ask": "force", "force": "normal", "body": "parcel", "at": 3}]}}
{"id": "hard-floor-2", "example": "floor-push", "style": "hard", "source": "hand-written", "question": "Someone leans on a 15 kg sled and pushes with 100 N, directed 30° below the horizontal. The pavement has mu_s = 0.6 and mu_k = 0.5. After 2 s, what is the sled's acceleration?", "scene": {"version": 1.1, "bodies": [{"id": "sled", "mass": "15 kg"}], "surfaces": [{"id": "pavement", "kind": "plane", "friction": {"static": 0.6, "kinetic": 0.5}}], "contacts": [{"body": "sled", "surface": "pavement"}], "forces": [{"id": "push", "kind": "applied", "body": "sled", "magnitude": "100 N", "directionAngle": "-30 deg", "relativeTo": "pavement"}], "queries": [{"id": "a", "ask": "acceleration", "body": "sled", "at": 2}]}}
{"id": "hard-incline-1", "example": "incline", "style": "hard", "source": "hand-written", "question": "A 12 kg toboggan is let go from rest at the top of a perfectly smooth slope 8 m long, inclined at 25° to the horizontal. Find its acceleration right at the start and the time it needs to reach the bottom of the slope.", "scene": {"version": 1.1, "bodies": [{"id": "toboggan", "mass": "12 kg", "placement": {"on": "slope", "at": "top"}}], "surfaces": [{"id": "slope", "kind": "plane", "angle": "25 deg", "extent": {"length": "8 m"}, "friction": {"static": 0, "kinetic": 0}}], "contacts": [{"body": "toboggan", "surface": "slope"}], "queries": [{"id": "a", "ask": "acceleration", "body": "toboggan", "at": 0}, {"id": "t", "ask": "time", "until": {"event": "edge"}, "body": "toboggan"}]}}
{"id": "hard-incline-2", "example": "incline", "style": "hard", "source": "hand-written", "question": "A 2 kg cart is released at the top of a smooth 250 cm track tilted at 30 degrees. Give the cart's acceleration at release and how long it takes to roll to the bottom end.", "scene": {"version": 1.1, "bodies": [{"id": "cart", "mass": "2 kg", "placement": {"on": "track", "at": "top"}}], "surfaces": [{"id": "track", "kind": "plane", "angle": "30 deg", "extent": {"length": "250 cm"}, "friction": {"static": 0, "kinetic": 0}}], "contacts": [{"body": "cart", "surface": "track"}], "queries": [{"id": "a", "ask": "acceleration", "body": "cart", "at": 0}, {"id": "t", "ask": "time", "until": {"event": "edge"}, "body": "cart"}]}}
{"id": "hard-incline-3", "example": "incline", "style": "hard", "source": "hand-written", "question": "Find the least coefficient of static friction that would keep a 6 kg block from slipping on a 35° incline, and the friction force acting on it 1 s after release. The incline is 3 m long and the block starts at rest at the top; the surface's actual coefficients are 0.8 (static) and 0.6 (kinetic).", "scene": {"version": 1.1, "bodies": [{"id": "block", "mass": "6 kg", "placement": {"on": "incline", "at": "top"}}], "surfaces": [{"id": "incline", "kind": "plane", "angle": "35 deg", "extent": {"length": "3 m"}, "friction": {"static": 0.8, "kinetic": 0.6}}], "contacts": [{"body": "block", "surface": "incline"}], "queries": [{"id": "mu", "ask": "min_mu_s", "body": "block"}, {"id": "f", "ask": "force", "force": "friction", "body": "block", "at": 1}]}}
{"id": "hard-ramp-1", "example": "ramp", "style": "hard", "source": "hand-written", "question": "A 40 kg crate sits on a rough ramp (mu_s = 0.5, mu_k = 0.4) inclined at 20 degrees. A worker pushes it with a 250 N force parallel to the ramp and up the slope. At the instant the push starts, what are the friction force and the normal force on the crate?", "scene": {"version": 1.1, "bodies": [{"id": "crate", "mass": "40 kg"}], "surfaces": [{"id": "ramp", "kind": "plane", "angle": "20 deg", "friction": {"static": 0.5, "kinetic": 0.4}}], "contacts": [{"body": "crate", "surface": "ramp"}], "forces": [{"id": "push", "kind": "applied", "body": "crate", "magnitude": "250 N", "directionAngle": "0 deg", "relativeTo": "ramp"}], "queries": [{"id": "f", "ask": "force", "force": "friction", "body": "crate", "at": 0}, {"id": "N", "ask": "force", "force": "normal", "body": "crate", "at": 0}]}}
{"id": "hard-stop-1", "example": "sliding-stop", "style": "hard", "source": "hand-written", "question": "A 3 kg hockey puck leaves a stick at 36 km/h across a rough rink floor with static friction 0.7 and kinetic friction 0.6. How long does it take the puck to come to rest?", "scene": {"version": 1.1, "bodies": [{"id": "puck", "mass": "3 kg", "velocity": {"speed": "36 km/h", "angle": "0 deg"}}], "surfaces": [{"id": "rink", "kind": "plane", "friction": {"static": 0.7, "kinetic": 0.6}}], "contacts": [{"body": "puck", "surface": "rink"}], "queries": [{"id": "t", "ask": "time", "until": {"event": "stop"}, "body": "puck"}]}}
{"id": "hard-stop-2", "example": "sliding-stop", "style": "hard", "source": "hand-written", "question": "A 500 g puck is sliding at 3 m/s on a table where the friction coefficients are 0.3 (static) and 0.2 (kinetic). When does it stop?", "scene": {"version": 1.1, "bodies": [{"id": "puck", "mass": "500 g", "velocity": {"speed": "3 m/s", "angle": "0 deg"}}], "surfaces": [{"id": "table", "kind": "plane", "friction": {"static": 0.3, "kinetic": 0.2}}], "contacts": [{"body": "puck", "surface": "table"}], "queries": [{"id": "t", "ask": "time", "until": {"event": "stop"}, "body": "puck"}]}}
